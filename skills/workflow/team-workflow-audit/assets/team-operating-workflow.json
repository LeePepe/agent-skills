{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "团队交付与审查工作流",
    "subtitle": "执行受阻时责任回到 Team Lead；审查只读，修复必须另行批准",
    "locale": "zh-CN",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "legend": {"mode": "hidden"},
    "views": [
      {
        "id": "delivery",
        "label": "正常交付",
        "focus": ["owner_intent", "tl_workdir", "fs_execute", "review_gate", "ci_merge", "owner_result"],
        "note": "从 Owner 意图、TL 创建工作目录、FS 执行到评审、CI 和结果确认。"
      },
      {
        "id": "recovery",
        "label": "阻碍恢复",
        "focus": ["fs_execute", "fs_impediment", "tl_recover", "owner_escalation"],
        "note": "FS 只报告阻碍；TL 恢复、改派或显式升级，不能留下无负责人的终态。"
      },
      {
        "id": "audit",
        "label": "只读审查",
        "focus": ["audit_observe", "aidash_display", "owner_approval"],
        "note": "审查引擎只记录证据并展示发现；Owner 批准后由另一个执行流程修复。"
      }
    ],
    "output": "assets/team-operating-workflow.html",
    "viewBox": [1500, 800]
  },
  "lanes": [
    {"id": "owner", "label": "Owner"},
    {"id": "tl", "label": "Team Lead"},
    {"id": "fs", "label": "Fullstack Engineer"},
    {"id": "gates", "label": "Reviewer / PR / CI"},
    {"id": "audit", "label": "Audit / AIDash", "variant": "exception"}
  ],
  "phases": [
    {"id": "intake", "label": "意图与准备", "fromCol": 0, "toCol": 1},
    {"id": "execute", "label": "执行与恢复", "fromCol": 2, "toCol": 3, "variant": "emphasis"},
    {"id": "verify", "label": "门禁与结论", "fromCol": 4, "toCol": 5, "variant": "dashed"}
  ],
  "groups": [
    {"id": "recovery_loop", "label": "TL 负责的恢复环", "lane": "tl", "fromCol": 2, "toCol": 4, "variant": "security"},
    {"id": "readonly_audit", "label": "只读证据链", "lane": "audit", "fromCol": 0, "toCol": 5, "variant": "dashed"}
  ],
  "mainPath": ["owner_intent", "tl_workdir", "fs_execute", "review_gate", "ci_merge", "owner_result"],
  "nodes": [
    {"id": "owner_intent", "lane": "owner", "col": 0, "type": "external", "label": "确认目标"},
    {"id": "owner_escalation", "lane": "owner", "col": 4, "type": "security", "label": "处理升级"},
    {"id": "owner_result", "lane": "owner", "col": 5, "type": "backend", "label": "确认结果"},
    {"id": "owner_approval", "lane": "audit", "col": 4, "type": "security", "label": "Owner 批准"},
    {"id": "tl_workdir", "lane": "tl", "col": 1, "type": "backend", "label": "创建 Workdir", "tag": "必需"},
    {"id": "tl_recover", "lane": "tl", "col": 3, "type": "messagebus", "label": "恢复或改派"},
    {"id": "fs_execute", "lane": "fs", "col": 2, "type": "backend", "label": "实现与测试"},
    {"id": "fs_impediment", "lane": "fs", "col": 3, "type": "security", "label": "报告阻碍"},
    {"id": "review_gate", "lane": "gates", "col": 4, "type": "security", "label": "独立评审"},
    {"id": "ci_merge", "lane": "gates", "col": 5, "type": "cloud", "label": "CI 与合并"},
    {"id": "audit_observe", "lane": "audit", "col": 0, "type": "database", "label": "审查证据"},
    {"id": "aidash_display", "lane": "audit", "col": 5, "type": "frontend", "label": "AIDash 展示"}
  ],
  "edges": [
    {"id": "intent-workdir", "from": "owner_intent", "to": "tl_workdir", "variant": "default"},
    {"id": "workdir-execute", "from": "tl_workdir", "to": "fs_execute", "variant": "emphasis"},
    {"id": "execute-review", "from": "fs_execute", "to": "review_gate", "variant": "default"},
    {"id": "review-merge", "from": "review_gate", "to": "ci_merge", "variant": "emphasis"},
    {"id": "merge-result", "from": "ci_merge", "to": "owner_result", "variant": "emphasis", "role": "return", "fromSide": "right", "toSide": "right", "route": "outside-right", "channelX": 800},
    {"id": "execute-impediment", "from": "fs_execute", "to": "fs_impediment", "variant": "security", "role": "error"},
    {"id": "impediment-recover", "from": "fs_impediment", "to": "tl_recover", "label": "责任返回 TL", "variant": "security"},
    {"id": "recover-execute", "from": "tl_recover", "to": "fs_execute", "variant": "dashed", "role": "return"},
    {"id": "recover-escalate", "from": "tl_recover", "to": "owner_escalation", "variant": "security", "role": "error"},
    {"id": "observe-approval", "from": "audit_observe", "to": "owner_approval", "label": "展示后由 Owner 决定", "variant": "dashed", "role": "async", "fromSide": "bottom", "toSide": "bottom", "route": "bottom-channel", "channelY": 700},
    {"id": "approval-display", "from": "owner_approval", "to": "aidash_display", "variant": "dashed", "role": "async", "fromSide": "top", "toSide": "top", "route": "up-channel", "channelY": 545}
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "交付不变量",
      "items": ["TL 创建并持有 Task Workdir", "FS 报告阻碍但不决定终态", "评审、测试、合并保持同一 SHA", "每个等待状态都有下一责任人"]
    },
    {
      "dot": "rose",
      "title": "升级规则",
      "items": ["TL 先恢复、重试或改派", "无法恢复才带证据升级 Owner", "重叠运行必须声明继任关系", "任何 Blocked 都不能静默结束"]
    },
    {
      "dot": "cyan",
      "title": "审查边界",
      "items": ["Conformance、Fitness、Outcome 独立判断", "AIDash 只展示快照与批准事件", "批准不等于自动执行", "修复由另一个明确授权的流程完成"]
    }
  ]
}
